# Variables prefixed with NEXT_PUBLIC_ are PUBLIC and are embedded in the browser bundle.
# Never put private keys, the service_role key or secrets in NEXT_PUBLIC_ variables.

# Public — Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public — Supabase anon/publishable key (Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional alias. Some Supabase + Vercel integrations expose the new key as
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (sb_publishable_...). The app accepts either.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Public — canonical URL of the store (used in SEO, sitemap and WhatsApp links)
# Local example: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — only if you intentionally need server-side admin operations.
# NEVER expose this key in client components or NEXT_PUBLIC_ variables.
# The current version does not use it.
# SUPABASE_SERVICE_ROLE_KEY=
